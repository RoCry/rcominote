<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="site.rocry.rcominote.probe">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <application android:label="CoMi bounded probe" android:debuggable="true" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

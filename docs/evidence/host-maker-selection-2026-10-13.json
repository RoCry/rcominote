  "upper_boundary": [
    "Launch.ProductionThread forwards port into Upgrade.UpgradeFW(port,log,script_dll,fw,int(index)).",
    "UpgradeFW body VA100085f0 reads port.sdk_reliable before branching; port is already a transport object, not parsed as a USB name here.",
    "USBDevice.__init__(self,usb_port,log,usb_dll) requires all four arguments. No default Hardware_C path is established by its string literal.",
    "load_usb_op_lib VA10004f80 returns True if usb_op already set; otherwise requires supplied usb_dll string and existing file before loading it.",
    "No GUI constructor selection or CoMi mapping established. Binding to held Hardware_C is conditional on supplied DLL path selecting that exact file."
  ],
  "usb_device": {
    "constructor": "VA10008600 sets usb_dev_index=0, connection=False, connect_type=USB, sdk_reliable=False; usb_port and usb_dll copied from required arguments.",
    "open": "VA10009600 calls load_usb_op_lib(), then self.usb_op.Py_ADFU_Enum() with zero arguments.",
    "enum_check": "enum result ==0 is rejected; >1 logs selection. No claim negative results are rejected.",
    "index": "Regex object usb_device_name_p searches usb_port; on match int(match.groups()[1]) becomes usb_dev_index; no match retains current index (initial0). Pattern literal is verbose word-boundary (ADFU|USB)(digits+) word-boundary.",
    "open_call": "self.usb_op.Py_ADFU_Open(self.usb_dev_index); result ==-1 rejected, otherwise connection=True and usb_op_handle=result, then resume rx thread.",
    "non_probe": "connect_com VA10005780 simply returns Python True, without transport I/O."
  },
